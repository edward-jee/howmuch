<Window x:Class="howmuch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HowMuch · KRW estimate" Width="384" Height="622"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        FontFamily="Segoe UI" FontSize="13" Foreground="#17243C"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="#17243C">
                <Border Background="Transparent" Margin="0,0,78,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll"
                        ToolTip="Drag to move the widget">
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="HowMuch" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="  /  KRW" Foreground="#A8B9D4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                    <Button Content="−" Width="34" Background="Transparent" Foreground="White"
                            BorderThickness="0" Click="Minimize_Click" ToolTip="Minimize to taskbar"
                            AutomationProperties.Name="Minimize widget"/>
                    <Button Content="×" Width="34" Background="Transparent" Foreground="White"
                            BorderThickness="0" Click="Close_Click" ToolTip="Close; run HowMuch again to reopen"
                            AutomationProperties.Name="Close widget"/>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="18,14">
                <TextBlock Text="FOREIGN PRICE" Foreground="#536581" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PriceInput" Text="0" FontSize="21" Margin="0,0,8,0" MaxLength="24"
                             TextChanged="Input_Changed" AutomationProperties.Name="Price in selected currency"
                             ToolTip="Include local tax and domestic shipping. Use a dot for decimals."/>
                    <ComboBox x:Name="CurrencyInput" Grid.Column="1" SelectionChanged="Currency_Changed"
                              AutomationProperties.Name="Currency"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Intl. shipping + insurance" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShippingInput" Text="0" MaxLength="24" TextChanged="Input_Changed"
                                 AutomationProperties.Name="International shipping and insurance in selected currency"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Duty rate (%)" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="DutyInput" Text="8" MaxLength="8" TextChanged="Input_Changed"
                                 AutomationProperties.Name="Estimated customs duty percentage"/>
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ExemptionInput" Content="Eligible for personal-use exemption" IsChecked="True"
                          Margin="0,12,0,0" Checked="Options_Changed" Unchecked="Options_Changed"
                          ToolTip="Turn off for goods without small-value exemption. Special taxes are not modeled."/>
                <CheckBox x:Name="UsInput" Content="Shipped from US · eligible for list clearance"
                          Margin="0,7,0,0" Checked="Options_Changed" Unchecked="Options_Changed"
                          ToolTip="Enables the USD 200 threshold. Otherwise USD 150 applies regardless of currency."/>
                <TextBlock x:Name="ValidationText" Foreground="#B42318" FontSize="11" Height="20" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E0E6EF" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Price in KRW" Foreground="#536581"/>
                            <TextBlock x:Name="PriceResult" Grid.Column="1" Text="—" TextAlignment="Right" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Shipping in KRW" Foreground="#536581"/>
                            <TextBlock x:Name="ShippingResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Estimated duty" Foreground="#536581"/>
                            <TextBlock x:Name="DutyResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Estimated VAT (10%)" Foreground="#536581"/>
                            <TextBlock x:Name="VatResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Height="1" Background="#E0E6EF" Margin="0,12,0,10"/>
                        <TextBlock Text="ESTIMATED TOTAL" FontSize="10" Foreground="#536581" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalResult" Text="—" FontSize="29" FontWeight="SemiBold" Foreground="#2459C4"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ExemptionText" FontSize="11" Foreground="#536581" Text="Waiting for exchange rates"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RateStatus" Text="Loading rates…" FontSize="11" Foreground="#536581"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" FontSize="11" Click="Refresh_Click"/>
                </Grid>
                <TextBlock x:Name="PersistenceStatus" FontSize="10" Foreground="#B42318" TextWrapping="Wrap"/>
                <TextBlock FontSize="10" Foreground="#687992" TextWrapping="Wrap" Margin="0,9,0,0"
                           Text="8% is an editable assumption. Actual tax depends on item classification, FTA and customs rates. Special taxes and card fees are excluded."/>
                <TextBlock FontSize="11" Margin="0,5,0,0">
                    <Hyperlink NavigateUri="https://www.customs.go.kr/kcs/ad/tax/BuyTaxCalculation.do"
                               RequestNavigate="Customs_RequestNavigate">Korea Customs Service calculator ↗</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
