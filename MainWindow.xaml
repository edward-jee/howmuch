<Window x:Class="howmuch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="얼마일까 · 해외직구 계산기" Width="384" Height="622"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource PageBrush}"
        Language="ko-KR" FontFamily="Malgun Gothic" FontSize="13" Foreground="{DynamicResource InkBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Gyaru.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
        <Grid x:Name="WidgetContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="{DynamicResource HeaderBrush}">
                <Border Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}"
                        Visibility="{DynamicResource DecorationVisibility}" IsHitTestVisible="False"/>
                <Border Background="Transparent" Margin="0,0,112,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll"
                        ToolTip="제목 표시줄을 드래그하여 이동">
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="얼마일까" Foreground="{DynamicResource HeaderInkBrush}" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="  ✦" Foreground="{DynamicResource HeaderMutedBrush}"
                                   Visibility="{DynamicResource DecorationVisibility}" VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="  /  원화 계산" Foreground="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                    <Button Content="?" Width="34" Background="Transparent" Foreground="{DynamicResource HeaderInkBrush}"
                            BorderThickness="0" Click="Help_Click" ToolTip="단축키 안내 (F1)"
                            AutomationProperties.Name="단축키 안내"/>
                    <Button Content="−" Width="34" Background="Transparent" Foreground="{DynamicResource HeaderInkBrush}"
                            BorderThickness="0" Click="Minimize_Click" ToolTip="작업 표시줄로 최소화 (Ctrl+M)"
                            AutomationProperties.Name="위젯 최소화"/>
                    <Button Content="×" Width="34" Background="Transparent" Foreground="{DynamicResource HeaderInkBrush}"
                            BorderThickness="0" Click="Close_Click" ToolTip="닫기 (Ctrl+W / Alt+F4) · 다시 보려면 앱을 실행하세요"
                            AutomationProperties.Name="위젯 닫기"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBlock Text="상품 가격" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Grid.Column="1" Text="단위" Foreground="{DynamicResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="PriceInput" Grid.Row="1" Text="0" FontSize="21" Margin="0,0,8,0" MaxLength="24"
                             TextChanged="Input_Changed" AutomationProperties.Name="선택한 통화의 상품 가격"
                             ToolTip="가격 입력: Ctrl+L · 현지 세금과 현지 배송비 포함 · 소수점은 마침표(.) 사용"/>
                    <ComboBox x:Name="CurrencyInput" Grid.Row="1" Grid.Column="1" SelectionChanged="Currency_Changed"
                              AutomationProperties.Name="통화" ToolTip="Ctrl+1: JPY · Ctrl+2: USD · Ctrl+3: EUR"/>
                </Grid>
                <CheckBox x:Name="UsInput" Content="미국에서 발송" Margin="0,14,0,0"
                          Checked="Options_Changed" Unchecked="Options_Changed"
                          ToolTip="미국 발송 선택·해제: Ctrl+U · 결제 통화와 관계없이 실제 발송 국가를 선택하세요."/>
                <RadioButton x:Name="GeneralGoodsInput" GroupName="GoodsType" IsChecked="True"
                             Content="일반 물품(목록 통관 대상)" Margin="0,12,0,0"
                             Checked="Options_Changed" ToolTip="일반 물품 선택 (Ctrl+G)"/>
                <RadioButton x:Name="ExcludedGoodsInput" GroupName="GoodsType" Margin="0,8,0,0"
                             Checked="Options_Changed" ToolTip="목록통관 제외 물품 선택 (Ctrl+Shift+G)">
                    <TextBlock Text="식품, 건강기능식품 등 목록통관 제외 물품" TextWrapping="Wrap"/>
                </RadioButton>
                <TextBlock x:Name="ThresholdText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                <Expander x:Name="AdvancedSettings" Header="추가 설정 · 배송비 / 관세율" FontSize="12" Margin="0,10,0,0"
                          ToolTip="추가 설정 펼치기·접기 (Ctrl+,)">
                    <StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="국제 배송비·보험료" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShippingInput" Text="0" MaxLength="24" TextChanged="Input_Changed"
                                 AutomationProperties.Name="선택한 통화의 국제 배송비와 보험료"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="관세율 (%)" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="DutyInput" Text="8" MaxLength="8" TextChanged="Input_Changed"
                                     AutomationProperties.Name="예상 관세율"/>
                            <Button x:Name="DutyAssistButton" Grid.Column="1" Content="?" Margin="4,0,0,0" Padding="0"
                                    Click="DutyAssist_Click" ToolTip="질문에 답해 관세율 찾기"
                                    AutomationProperties.Name="관세율 찾기 도움말"/>
                        </Grid>
                    </StackPanel>
                </Grid>
                        <TextBlock FontSize="10" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Text="관세율은 품목마다 다릅니다. 관세청에서 확인 후 조정하세요."/>
                        <TextBlock Text="화면 테마" FontSize="11" Margin="0,10,0,4"/>
                        <ComboBox x:Name="ThemeInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                                  SelectionChanged="Theme_Changed" AutomationProperties.Name="화면 테마"
                                  ToolTip="갸루·클래식 테마 전환 (Ctrl+T)"/>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="ValidationText" Foreground="{DynamicResource ErrorBrush}" FontSize="11" Height="20" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <Border x:Name="ResultCard" Background="{DynamicResource CardBrush}" CornerRadius="{DynamicResource CardRadius}" Padding="14" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="상품 가격 (원)" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="PriceResult" Grid.Column="1" Text="—" TextAlignment="Right" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="배송비 (원)" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="ShippingResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="예상 관세" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="DutyResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="예상 부가세 (10%)" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock x:Name="VatResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,10"/>
                        <Grid>
                            <TextBlock Text="예상 총 결제금액" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/>
                            <TextBlock Text="✧  ♥  ✧" HorizontalAlignment="Right" FontSize="12"
                                       Foreground="{DynamicResource DecorationBrush}" Visibility="{DynamicResource DecorationVisibility}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                        <TextBlock x:Name="TotalResult" Text="—" FontSize="29" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ExemptionText" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="환율을 확인하고 있습니다"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RateStatus" Text="환율을 불러오는 중…" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="새로고침" FontSize="11" Click="Refresh_Click"
                            ToolTip="환율 새로고침 (F5)"/>
                </Grid>
                <TextBlock x:Name="PersistenceStatus" FontSize="10" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"/>
                <TextBlock FontSize="10" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" Margin="0,9,0,0"
                           Text="자가사용 기준 예상액 · 품목별 관세율은 추가 설정에서 조정하세요. 실제 세액은 통관 환율·세율에 따라 달라집니다."/>
                <TextBlock FontSize="11" Margin="0,5,0,0">
                    <Hyperlink NavigateUri="https://www.customs.go.kr/kcs/ad/tax/BuyTaxCalculation.do"
                               RequestNavigate="Customs_RequestNavigate">관세청 품목별 세액 확인 ↗</Hyperlink>
                </TextBlock>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <Grid x:Name="HelpOverlay" Visibility="Collapsed" Background="#77000000"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Margin="16" Padding="16" VerticalAlignment="Center" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}">
                <StackPanel>
                    <TextBlock Text="단축키 안내" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="위젯 창이 선택되어 있을 때 사용할 수 있어요." FontSize="11"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,14" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="ShortcutList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Keys}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Tab 이동 · Ctrl+A/C/V 입력 편집 · Alt+F4 종료" FontSize="10"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12"/>
                    <Button x:Name="HelpCloseButton" Content="닫기 (Esc)" Click="HelpClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
    </Border>
</Window>
