<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <LinearGradientBrush x:Key="PageBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF0F8" Offset="0"/>
        <GradientStop Color="#FFE1F1" Offset="0.6"/>
        <GradientStop Color="#FFF3DA" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="InkBrush" Color="#301426"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#733855"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#795166"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D83A88"/>
    <!-- A subtle zebra repeat keeps the chrome playful without obscuring the title. -->
    <DrawingBrush x:Key="HeaderBrush" TileMode="Tile" Viewport="0,0,72,48" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#21111E" Geometry="M0,0 H72 V48 H0 Z"/>
                <GeometryDrawing Brush="#4B193B" Geometry="M2,0 L18,0 42,48 25,48 Z M40,0 L52,0 72,35 72,48 64,48 Z"/>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <SolidColorBrush x:Key="HeaderInkBrush" Color="#FFF4D5"/>
    <SolidColorBrush x:Key="HeaderMutedBrush" Color="#FFADDA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFAFD"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E777AE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#B80B61"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#AB123A"/>
    <SolidColorBrush x:Key="InputBrush" Color="#FFF9FC"/>
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFE0EF"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFC2DE"/>
    <SolidColorBrush x:Key="DecorationBrush" Color="#B47A23"/>
    <CornerRadius x:Key="CardRadius">16</CornerRadius>
    <Visibility x:Key="DecorationVisibility">Visible</Visibility>
</ResourceDictionary>
