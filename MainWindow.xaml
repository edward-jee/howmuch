<Window x:Class="howmuch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="얼마일까 · 해외직구 계산기" Width="384" Height="622"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterScreen" Background="#F5F7FB"
        Language="ko-KR" FontFamily="Malgun Gothic" FontSize="13" Foreground="#17243C"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#CBD5E1" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Background="#17243C">
                <Border Background="Transparent" Margin="0,0,78,0"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll"
                        ToolTip="제목 표시줄을 드래그하여 이동">
                    <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Text="얼마일까" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="  /  원화 계산" Foreground="#A8B9D4" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
                    <Button Content="−" Width="34" Background="Transparent" Foreground="White"
                            BorderThickness="0" Click="Minimize_Click" ToolTip="작업 표시줄로 최소화"
                            AutomationProperties.Name="위젯 최소화"/>
                    <Button Content="×" Width="34" Background="Transparent" Foreground="White"
                            BorderThickness="0" Click="Close_Click" ToolTip="닫기 · 다시 보려면 앱을 실행하세요"
                            AutomationProperties.Name="위젯 닫기"/>
                </StackPanel>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="18,14">
                <TextBlock Text="상품 가격" Foreground="#536581" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="PriceInput" Text="0" FontSize="21" Margin="0,0,8,0" MaxLength="24"
                             TextChanged="Input_Changed" AutomationProperties.Name="선택한 통화의 상품 가격"
                             ToolTip="현지 세금과 현지 배송비를 포함하세요. 소수점은 마침표(.)를 사용하세요."/>
                    <ComboBox x:Name="CurrencyInput" Grid.Column="1" SelectionChanged="Currency_Changed"
                              AutomationProperties.Name="통화"/>
                </Grid>
                <CheckBox x:Name="UsInput" Content="미국에서 발송" Margin="0,14,0,0"
                          Checked="Options_Changed" Unchecked="Options_Changed"
                          ToolTip="결제 통화와 관계없이 실제 발송 국가를 선택하세요."/>
                <RadioButton x:Name="GeneralGoodsInput" GroupName="GoodsType" IsChecked="True"
                             Content="일반 물품(목록 통관 대상)" Margin="0,12,0,0"
                             Checked="Options_Changed"/>
                <RadioButton x:Name="ExcludedGoodsInput" GroupName="GoodsType" Margin="0,8,0,0"
                             Checked="Options_Changed">
                    <TextBlock Text="식품, 건강기능식품 등 목록통관 제외 물품" TextWrapping="Wrap"/>
                </RadioButton>
                <TextBlock x:Name="ThresholdText" FontSize="11" Foreground="#536581" Margin="0,8,0,0"/>
                <Expander x:Name="AdvancedSettings" Header="추가 설정 · 배송비 / 관세율" FontSize="12" Margin="0,10,0,0">
                    <StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="국제 배송비·보험료" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="ShippingInput" Text="0" MaxLength="24" TextChanged="Input_Changed"
                                 AutomationProperties.Name="선택한 통화의 국제 배송비와 보험료"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="관세율 (%)" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="DutyInput" Text="8" MaxLength="8" TextChanged="Input_Changed"
                                 AutomationProperties.Name="예상 관세율"/>
                    </StackPanel>
                </Grid>
                        <TextBlock FontSize="10" Foreground="#687992" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Text="관세율은 품목마다 다릅니다. 관세청에서 확인 후 조정하세요."/>
                    </StackPanel>
                </Expander>
                <TextBlock x:Name="ValidationText" Foreground="#B42318" FontSize="11" Height="20" Margin="0,6,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <Border Background="White" CornerRadius="8" Padding="14" BorderBrush="#E0E6EF" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="상품 가격 (원)" Foreground="#536581"/>
                            <TextBlock x:Name="PriceResult" Grid.Column="1" Text="—" TextAlignment="Right" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="배송비 (원)" Foreground="#536581"/>
                            <TextBlock x:Name="ShippingResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="예상 관세" Foreground="#536581"/>
                            <TextBlock x:Name="DutyResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="예상 부가세 (10%)" Foreground="#536581"/>
                            <TextBlock x:Name="VatResult" Grid.Column="1" Text="—" TextAlignment="Right"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Grid>
                        <Border Height="1" Background="#E0E6EF" Margin="0,12,0,10"/>
                        <TextBlock Text="예상 총 결제금액" FontSize="10" Foreground="#536581" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TotalResult" Text="—" FontSize="29" FontWeight="SemiBold" Foreground="#2459C4"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ExemptionText" FontSize="11" Foreground="#536581" Text="환율을 확인하고 있습니다"/>
                    </StackPanel>
                </Border>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="RateStatus" Text="환율을 불러오는 중…" FontSize="11" Foreground="#536581"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="새로고침" FontSize="11" Click="Refresh_Click"/>
                </Grid>
                <TextBlock x:Name="PersistenceStatus" FontSize="10" Foreground="#B42318" TextWrapping="Wrap"/>
                <TextBlock FontSize="10" Foreground="#687992" TextWrapping="Wrap" Margin="0,9,0,0"
                           Text="자가사용 기준 예상액 · 품목별 관세율은 추가 설정에서 조정하세요. 실제 세액은 통관 환율·세율에 따라 달라집니다."/>
                <TextBlock FontSize="11" Margin="0,5,0,0">
                    <Hyperlink NavigateUri="https://www.customs.go.kr/kcs/ad/tax/BuyTaxCalculation.do"
                               RequestNavigate="Customs_RequestNavigate">관세청 품목별 세액 확인 ↗</Hyperlink>
                </TextBlock>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
