<Window x:Class="howmuch.DutyAdvisorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="관세율 찾기" Width="420" Height="620" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Language="ko-KR" FontFamily="Malgun Gothic" FontSize="12"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="관세율을 함께 찾아볼까요?" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="세 가지 질문에 답하면 참고할 관세율을 제안합니다." Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,16" TextWrapping="Wrap"/>
                <TextBlock Text="1. 어떤 종류의 물품인가요?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <ComboBox x:Name="CategoryInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectionChanged="Category_Changed" AutomationProperties.Name="물품 종류"/>
                <TextBlock Text="2. 가장 가까운 세부 품목은 무엇인가요?" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <ComboBox x:Name="ProfileInput" DisplayMemberPath="Label" SelectedValuePath="Id"
                          SelectionChanged="Answer_Changed" AutomationProperties.Name="세부 품목"/>
                <TextBlock Text="3. 감면 세율이나 특별세를 확인했나요?" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <ComboBox x:Name="TreatmentInput" SelectedIndex="0" SelectionChanged="Answer_Changed"
                          AutomationProperties.Name="감면 세율과 특별세 여부">
                    <ComboBoxItem Content="감면 미확인 · 대표 관세율로 추정"/>
                    <ComboBoxItem Content="공식 확인한 적용 관세율이 있어요"/>
                    <ComboBoxItem Content="주류·담배·고가품 등 특별세 대상이에요"/>
                </ComboBox>
                <StackPanel x:Name="ConfirmedRatePanel" Visibility="Collapsed" Margin="0,10,0,0">
                    <TextBlock Text="공식 확인한 관세율 (%)" Margin="0,0,0,5"/>
                    <TextBox x:Name="ConfirmedRateInput" MaxLength="8" Padding="8,6" TextChanged="Rate_Changed"
                             Background="{DynamicResource InputBrush}" Foreground="{DynamicResource InkBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" AutomationProperties.Name="공식 확인한 관세율"/>
                </StackPanel>
                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock x:Name="RateResult" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="GoodsTypeText" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                           Text="대표값은 확정 세율이 아닙니다. 발송 국가만으로 FTA 세율을 정하지 않으며, 면세 여부는 적용 후 상품 가격으로 따로 계산합니다."/>
                <TextBlock Margin="0,10,0,10">
                    <Hyperlink x:Name="SourceLink" RequestNavigate="Source_RequestNavigate"
                               Foreground="{DynamicResource AccentBrush}">관세청 근거·품목별 세율 확인 ↗</Hyperlink>
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button x:Name="CancelButton" Content="취소 (Esc)" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Grid.Column="1" Content="관세율 적용" IsDefault="True" IsEnabled="False" Click="Apply_Click"/>
        </Grid>
    </Grid>
</Window>
